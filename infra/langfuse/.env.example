# Langfuse Self-Hosted Configuration
# Copy this to .env and update values before deploying

# PostgreSQL credentials
POSTGRES_PASSWORD=changeme_postgres_password

# ClickHouse credentials
CLICKHOUSE_PASSWORD=changeme_clickhouse_password

# Redis password
REDIS_PASSWORD=changeme_redis_password

# MinIO (S3-compatible storage) credentials
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=changeme_minio_password

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=changeme_nextauth_secret

# Salt for hashing (generate with: openssl rand -base64 32)
SALT=changeme_salt_value

# Encryption key for sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=changeme_64char_hex_encryption_key
