# vLLM GenRM Server
VLLM_BASE_URL=http://localhost:8000/v1

# Azure OpenAI (GPT-4.1) - Synthetic system prompt generation
# You must create an Azure OpenAI deployment and set its deployment name below.
# AZURE_OPENAI_ENDPOINT can be either:
#   - https://<your-resource>.openai.azure.com
#   - a full URL copied from the Azure portal (the client will normalize it, and can extract api-version + deployment)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_GPT41=
